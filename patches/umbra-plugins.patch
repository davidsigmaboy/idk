diff --git a/Ghostgram/Features/Messages/Sources/Plugins/GGPluginHost.swift b/Ghostgram/Features/Messages/Sources/Plugins/GGPluginHost.swift
new file mode 100644
index 00000000..3a9d8fe1
--- /dev/null
+++ b/Ghostgram/Features/Messages/Sources/Plugins/GGPluginHost.swift
@@ -0,0 +1,211 @@
+import Foundation
+import Darwin
+
+/// Runs exteraGram-compatible plugins (`plugins-shim`) in an embedded CPython.
+///
+/// Python.framework, the standard library and the shim are NOT part of the Bazel build: the CI adds them
+/// to the IPA afterwards (`Frameworks/Python.framework`, `python/lib/python3.x`, `python/umbra`).
+/// The library is opened at run time (`dlopen`), so an app without them behaves as before: every call
+/// returns nil. Nothing is started before the first outgoing message while the setting is on.
+final class GGPluginHost {
+    static let shared = GGPluginHost()
+
+    private typealias PyObject = UnsafeMutableRawPointer
+
+    private struct Api {
+        let initialize: @convention(c) (Int32) -> Void
+        let saveThread: @convention(c) () -> UnsafeMutableRawPointer?
+        let gilEnsure: @convention(c) () -> Int32
+        let gilRelease: @convention(c) (Int32) -> Void
+        let runString: @convention(c) (UnsafePointer<CChar>) -> Int32
+        let addModule: @convention(c) (UnsafePointer<CChar>) -> PyObject?
+        let getAttr: @convention(c) (PyObject, UnsafePointer<CChar>) -> PyObject?
+        let fromString: @convention(c) (UnsafePointer<CChar>) -> PyObject?
+        let callOne: @convention(c) (PyObject, PyObject) -> PyObject?
+        let asUTF8: @convention(c) (PyObject) -> UnsafePointer<CChar>?
+        let decRef: @convention(c) (PyObject) -> Void
+        let errClear: @convention(c) () -> Void
+    }
+
+    private enum State {
+        case notStarted
+        case ready
+        case unavailable
+    }
+
+    private let lock = NSLock()
+    private var state: State = .notStarted
+    private var api: Api?
+    private var handler: PyObject?
+
+    /// Folder the user drops `.plugin` files into (visible in the Files app).
+    private var pluginsDirectory: String? {
+        guard let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        return documents.appendingPathComponent("Plugins", isDirectory: true).path
+    }
+
+    /// The text after the plugins, or nil when nothing changed / plugins are not available / one of them
+    /// cancelled the message (a cancel is not applied yet: the message is sent as it is).
+    func transformOutgoing(_ text: String) -> String? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard self.prepare() else {
+            return nil
+        }
+        if let directory = self.pluginsDirectory {
+            _ = self.request(["op": "sync", "dir": directory])
+        }
+        guard let result = self.request(["op": "send", "account": 0, "params": ["message": text]]) else {
+            return nil
+        }
+        if let cancel = result["cancel"] as? Bool, cancel {
+            return nil
+        }
+        guard let params = result["params"] as? [String: Any], let message = params["message"] as? String else {
+            return nil
+        }
+        return message == text ? nil : message
+    }
+
+    /// Number of loaded plugins and the load errors, for the settings screen.
+    func status() -> (count: Int, errors: [String: String])? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard self.prepare(), let directory = self.pluginsDirectory, let result = self.request(["op": "sync", "dir": directory]) else {
+            return nil
+        }
+        return (result["count"] as? Int ?? 0, result["errors"] as? [String: String] ?? [:])
+    }
+
+    // MARK: - Python
+
+    private func prepare() -> Bool {
+        switch self.state {
+        case .ready:
+            return true
+        case .unavailable:
+            return false
+        case .notStarted:
+            if self.start() {
+                self.state = .ready
+                return true
+            }
+            self.state = .unavailable
+            return false
+        }
+    }
+
+    private func start() -> Bool {
+        let bundle = Bundle.main
+        guard let frameworks = bundle.privateFrameworksPath else {
+            return false
+        }
+        let home = bundle.bundlePath + "/python"
+        let library = home + "/lib"
+        let fileManager = FileManager.default
+        guard let versions = try? fileManager.contentsOfDirectory(atPath: library),
+              let version = versions.sorted().last(where: { $0.hasPrefix("python3") }),
+              fileManager.fileExists(atPath: library + "/" + version + "/encodings/__init__.py"),
+              fileManager.fileExists(atPath: home + "/umbra/umbra_bootstrap.py") else {
+            // Without the standard library Py_Initialize would abort the app.
+            return false
+        }
+        guard let handle = dlopen(frameworks + "/Python.framework/Python", RTLD_NOW | RTLD_GLOBAL) else {
+            return false
+        }
+        guard let api = GGPluginHost.loadApi(handle) else {
+            return false
+        }
+        var dataDirectory = NSTemporaryDirectory()
+        if let support = fileManager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first {
+            dataDirectory = support.appendingPathComponent("UmbraPlugins", isDirectory: true).path
+        }
+        try? fileManager.createDirectory(atPath: dataDirectory, withIntermediateDirectories: true)
+        setenv("PYTHONHOME", home, 1)
+        setenv("PYTHONDONTWRITEBYTECODE", "1", 1)
+        setenv("PYTHONNOUSERSITE", "1", 1)
+        setenv("UMBRA_PLUGIN_DATA", dataDirectory, 1)
+        api.initialize(0)
+        let script = "import sys\nsys.path.insert(0, \"" + home + "/umbra\")\nimport umbra_bootstrap\n"
+        let status = script.withCString { api.runString($0) }
+        var function: PyObject?
+        if status == 0 {
+            function = "umbra_bootstrap".withCString { name in
+                api.addModule(name).flatMap { module in
+                    "handle".withCString { attribute in api.getAttr(module, attribute) }
+                }
+            }
+        }
+        // Release the GIL taken by Py_Initialize: later calls take it with PyGILState_Ensure.
+        _ = api.saveThread()
+        guard let function else {
+            return false
+        }
+        self.api = api
+        self.handler = function
+        return true
+    }
+
+    private static func loadApi(_ handle: UnsafeMutableRawPointer) -> Api? {
+        func symbol<T>(_ name: String, _ type: T.Type) -> T? {
+            guard let pointer = dlsym(handle, name) else {
+                return nil
+            }
+            return unsafeBitCast(pointer, to: type)
+        }
+        guard let initialize = symbol("Py_InitializeEx", (@convention(c) (Int32) -> Void).self),
+              let saveThread = symbol("PyEval_SaveThread", (@convention(c) () -> UnsafeMutableRawPointer?).self),
+              let gilEnsure = symbol("PyGILState_Ensure", (@convention(c) () -> Int32).self),
+              let gilRelease = symbol("PyGILState_Release", (@convention(c) (Int32) -> Void).self),
+              let runString = symbol("PyRun_SimpleString", (@convention(c) (UnsafePointer<CChar>) -> Int32).self),
+              let addModule = symbol("PyImport_AddModule", (@convention(c) (UnsafePointer<CChar>) -> PyObject?).self),
+              let getAttr = symbol("PyObject_GetAttrString", (@convention(c) (PyObject, UnsafePointer<CChar>) -> PyObject?).self),
+              let fromString = symbol("PyUnicode_FromString", (@convention(c) (UnsafePointer<CChar>) -> PyObject?).self),
+              let callOne = symbol("PyObject_CallOneArg", (@convention(c) (PyObject, PyObject) -> PyObject?).self),
+              let asUTF8 = symbol("PyUnicode_AsUTF8", (@convention(c) (PyObject) -> UnsafePointer<CChar>?).self),
+              let decRef = symbol("Py_DecRef", (@convention(c) (PyObject) -> Void).self),
+              let errClear = symbol("PyErr_Clear", (@convention(c) () -> Void).self) else {
+            return nil
+        }
+        return Api(initialize: initialize, saveThread: saveThread, gilEnsure: gilEnsure, gilRelease: gilRelease, runString: runString, addModule: addModule, getAttr: getAttr, fromString: fromString, callOne: callOne, asUTF8: asUTF8, decRef: decRef, errClear: errClear)
+    }
+
+    /// One JSON round trip to `umbra_bootstrap.handle`. Returns the `result` object of an ok response.
+    private func request(_ object: [String: Any]) -> [String: Any]? {
+        guard let api = self.api, let handler = self.handler,
+              let data = try? JSONSerialization.data(withJSONObject: object),
+              let json = String(data: data, encoding: .utf8) else {
+            return nil
+        }
+        let gil = api.gilEnsure()
+        defer {
+            api.gilRelease(gil)
+        }
+        guard let argument = json.withCString({ api.fromString($0) }) else {
+            api.errClear()
+            return nil
+        }
+        defer {
+            api.decRef(argument)
+        }
+        guard let response = api.callOne(handler, argument) else {
+            api.errClear()
+            return nil
+        }
+        defer {
+            api.decRef(response)
+        }
+        guard let characters = api.asUTF8(response) else {
+            api.errClear()
+            return nil
+        }
+        let text = String(cString: characters)
+        guard let parsed = try? JSONSerialization.jsonObject(with: Data(text.utf8)) as? [String: Any],
+              parsed["ok"] as? Bool == true else {
+            return nil
+        }
+        return parsed["result"] as? [String: Any]
+    }
+}
