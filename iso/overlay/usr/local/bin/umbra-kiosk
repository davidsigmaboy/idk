#!/bin/sh
export XDG_RUNTIME_DIR=/tmp/xdg-umbra
mkdir -p -m 700 "$XDG_RUNTIME_DIR"
export LIBSEAT_BACKEND=seatd
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
# wait for the local server
i=0
while [ $i -lt 60 ]; do
  wget -q -O /dev/null http://127.0.0.1:8080/umbra-ping && break
  i=$((i+1)); sleep 1
done
exec cage -s -- chromium --kiosk --no-first-run --disable-gpu --disable-infobars \
  --ozone-platform=wayland --user-data-dir=/home/umbra/chromium http://127.0.0.1:8080/
